# Copy this file to .env and provide authorized lab credentials.
MICROSHIELD_USERNAME=your-lab-username
MICROSHIELD_PASSWORD=your-lab-password

# JWT tests run only on explicitly allowlisted GET endpoints.
# Methods and paths must match Discovery; non-GET methods are reported as skipped.
# MICROSCAN_JWT_ENDPOINT_ALLOWLIST=[{"method":"GET","path":"/api/users/me"},{"method":"GET","path":"/api/orders/1"}]
# Automatic local-lab selection defaults to at most five prioritized route groups.
# MICROSCAN_JWT_ENDPOINT_BUDGET=5
# Active BOLA checks use a separate per-scan GET budget (default 10, range 1-100).
# MICROSCAN_BOLA_REQUEST_BUDGET=10
# Response evidence traversal defaults to three array items / resource samples,
# and can be raised to a bounded value from 1 to 25.
# MICROSCAN_EVIDENCE_TRAVERSAL_LIMIT=5

# Optional alternative to MICROSHIELD_USERNAME / MICROSHIELD_PASSWORD.
# Do not set this alongside the username/password variables unless you intend
# this JSON payload to take precedence.
# MICROSCAN_LOGIN_PAYLOAD={"username":"your-lab-username","password":"your-lab-password"}
# MICROSCAN_JWT_ENDPOINT_ALLOWLIST=[{"method":"GET","path":"/api/orders/1"}]

# Optional legacy API Gateway override. The trusted localhost lab profile
# automatically pairs frontend port 3000 with Gateway port 8085.
# MICROSCAN_GATEWAY_TARGET=http://localhost:8085