# Copy this file to .env and replace the placeholders with authorized lab values.
MICROSHIELD_USERNAME=userA
MICROSHIELD_PASSWORD=123456

# Optional: defaults to a discovered login candidate when omitted.
MICROSCAN_LOGIN_ENDPOINT=http://localhost:8085/api/auth/login

# JWT tests run only on explicitly allowlisted GET endpoints.
# Methods and paths must match Discovery; non-GET methods are reported as skipped.
# MICROSCAN_JWT_ENDPOINT_ALLOWLIST=[{"method":"GET","path":"/api/users/me"},{"method":"GET","path":"/api/orders/1"}]
# Automatic local-lab selection defaults to at most five prioritized route groups.
# MICROSCAN_JWT_ENDPOINT_BUDGET=5

# Optional alternative to MICROSHIELD_USERNAME / MICROSHIELD_PASSWORD.
# Do not set this alongside the username/password variables unless you intend
# this JSON payload to take precedence.
# MICROSCAN_LOGIN_PAYLOAD={"username":"your-lab-username","password":"your-lab-password"}
MICROSCAN_JWT_ENDPOINT_ALLOWLIST=[{"method":"GET","path":"/api/inventory"},{"method":"GET","path":"/api/inventory/"},{"method":"GET","path":"/api/orders"},{"method":"GET","path":"/api/orders/1"},{"method":"GET","path":"/api/orders/2"},{"method":"GET","path":"/api/orders/3"},{"method":"GET","path":"/api/orders/4"},{"method":"GET","path":"/api/orders/5"},{"method":"GET","path":"/api/orders/check/"},{"method":"GET","path":"/api/admin/dashboard"},{"method":"GET","path":"/api/users"},{"method":"GET","path":"/api/users/1"},{"method":"GET","path":"/api/users/2"},{"method":"GET","path":"/api/users/3"},{"method":"GET","path":"/api/users/4"},{"method":"GET","path":"/api/users/5"}]