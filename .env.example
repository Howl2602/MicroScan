# Copy this file to .env and replace the placeholders with authorized lab values.
MICROSHIELD_USERNAME=userA
MICROSHIELD_PASSWORD=123456

# Optional: defaults to a discovered login candidate when omitted.
MICROSCAN_LOGIN_ENDPOINT=http://localhost:8085/api/auth/login

# Optional alternative to MICROSHIELD_USERNAME / MICROSHIELD_PASSWORD.
# Do not set this alongside the username/password variables unless you intend
# this JSON payload to take precedence.
# MICROSCAN_LOGIN_PAYLOAD={"username":"your-lab-username","password":"your-lab-password"}
